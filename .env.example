# Server-only proxy target for `vite` (NOT exposed to the browser â€” no VITE_ prefix).
# Browser config is hardcoded in src/lib/config.ts

API_PROXY_TARGET=https://staging.phantix.site
DEV_PORT=5173
# Google / GitHub sign-in on the app login (Firebase web config — public values).
# Vite reads these from the app folder, so set them in apps/securegraph-core/.env
# locally and in the Core Vercel project's environment. Empty hides the buttons.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=graph-679b0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=graph-679b0
