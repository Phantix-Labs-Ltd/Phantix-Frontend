# ---------------------------------------------------------------------------
# Staff portal — staff.phantixlabs.com  (internal console)
# No CSP yet: this app loads xterm/redoc/lottie and a backend terminal. Add one
# after inventorying its third-party origins (Vercel never set one here either).
#@APP:staff@#
server {
    listen 80;
    server_name ${FE_HOST_STAFF};
    server_tokens off;

    root /usr/share/nginx/html/staff/dist;
    index index.html;

    include /etc/nginx/snippets/gzip.conf;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control $phantix_cache_control always;

    # Staff uploads/imports can be large; the backend caps what it accepts.
    client_max_body_size 200m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # The portal proxies /api (not /api/v1) plus the public sandbox-apply form.
    location /api/ {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_pass ${API_PROXY_TARGET};
    }

    # `/sandbox-apply` without the trailing slash would 301 to `/sandbox-apply/`
    # (nginx normalises a slash-terminated location), so match it exactly first.
    location = /sandbox-apply {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_pass ${API_PROXY_TARGET};
    }

    location /sandbox-apply/ {
        include /etc/nginx/snippets/api-proxy.conf;
        proxy_pass ${API_PROXY_TARGET};
    }

    location / {
        try_files $uri $uri/index.html $uri/ /index.html;
    }
}
#@END:staff@#

